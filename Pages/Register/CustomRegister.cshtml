@page
@model ProgrammerTuajew.Pages.Register.CustomRegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex justify-content-center align-items-center" style="background-color: #47d0fe; height: 100vh;">
    <div class="card" style="background-color: #03598f; color: white; border-radius: 15px; padding: 20px; max-width: 400px; width: 100%;">
        <div class="card-body">
            <h2 class="text-center">Register</h2>
            <h4 class="text-center" style="color: #b3e5fc;">Create a new account.</h4>

            @if (Model.ErrorMessage != null)
            {
                <div id="error-message" class="alert alert-danger" style="background-color: #ffcccc; color: #660000;">
                    @Model.ErrorMessage
                    <button type="button" onclick="hideErrorMessage()" class="close" style="color: #660000;">&times;</button>
                </div>
            }

            <form method="post">
                <div class="form-group">
                    <label for="email" style="color: white;">Email</label>
                    <input type="email" id="email" name="Email" class="form-control" asp-for="Email" required />
                </div>
                <div class="form-group mt-3">
                    <label for="password" style="color: white;">Password</label>
                    <input type="password" id="password" name="Password" class="form-control" asp-for="Password" required />
                </div>
                <div class="form-group mt-3">
                    <label for="confirmPassword" style="color: white;">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control" asp-for="ConfirmPassword" required />
                </div>

                <div class="form-group mt-3">
                    <label for="department" style="color: white;">Department</label>
                    <select id="department" name="Department" class="form-control" asp-for="Department" required>
                        <option value="">Select Department</option>
                        <option value="SaleD1">SaleD1</option>
                        <option value="SaleD2">SaleD2</option>
                        <option value="SaleD3">SaleD3</option>
                        <option value="Warehouse">Warehouse</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-4">Register</button>
            </form>
        </div>
    </div>
</div>

<script>
    function hideErrorMessage() {
        document.getElementById("error-message").style.display = "none";
    }
</script>
