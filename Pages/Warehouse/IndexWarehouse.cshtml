@page
@model ProgrammerTuajew.Pages.Warehouse.IndexWarehouseModel
@{
    ViewData["Title"] = "Warehouse";
}

<style>
    body {
        background-color: transparent;
    }

    .container {
        background-color: #4CC9FE;
        border-radius: 0px;
        padding: 20px;
        max-width: 1310px;
        margin: 20px auto;
        box-shadow: 0px 0px 0px rgba(0, 0, 0, 0.1);
    }

    .btn-add-email {
        background-color: #3D3BF3 !important;
        color: white !important;
        font-size: 16px;
        font-weight: bold;
    }

    .btn-inbox, .btn-sent {
        font-size: 16px;
        font-weight: bold;
    }

    .btn-inbox {
        background-color: #3C3D37 !important;
        color: white !important;
    }

    .btn-sent {
        background-color: #FFE31A !important;
        color: black !important;
    }

    .table th {
        background-color: #37AFE1;
        color: white;
        text-align: center;
        font-weight: bold;
    }

    #email-popup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 40%;
        padding: 20px;
        background: #4CC9FE;
        border: 1px solid black;
        z-index: 1000;
        color: white;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
</style>

<div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="csrf-form" method="post">
        @Html.AntiForgeryToken()
    </form>


    <div class="mb-3">
        <a class="btn btn-add-email" href="/Warehouse/CreateWarehouse">Add Email</a>
        <a class="btn btn-inbox" href="/Warehouse/IndexWarehouse?view=inbox">Inbox</a>
        <a class="btn btn-sent" href="/Warehouse/IndexWarehouse?view=sent">Sent</a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Sender</th>
                <th>Receiver</th>
                <th>Receiver Department</th>
                <th>Subject</th>
                <th>Body</th>
                <th>Date Sent</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.View.ToLower() == "inbox" && Model.InboxList.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center">ไม่มีข้อมูลใน Inbox</td>
                </tr>
            }
            else
            {
                var emailList = Model.View.ToLower() == "sent" ? Model.SentList : Model.InboxList;
                foreach (var item in emailList)
                {
                    <tr data-id="@item.Id">
                        <td>@item.Id</td>
                        <td>@item.Sender</td>
                        <td>@item.Receiver</td>
                        <td>@item.ReceiverDepartment</td>
                        <td>@item.Subject</td>
                        <td>@item.Body</td>
                        <td>@item.DateSent?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.IsRead == true)
                            {
                                <span class="badge bg-success">Read</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unread</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-info btn-sm"
                                    onclick="showEmailDetails('@item.Id', '@item.Sender', '@item.Receiver', '@item.ReceiverDepartment', '@item.Subject', '@item.Body', '@item.DateSent?.ToString("yyyy-MM-dd")')">
                                View
                            </button>
                            <div class="action-buttons">
                                @if (Model.View.ToLower() == "sent")
                                {
                                    <a asp-page="./EditWarehouse" asp-route-itemid="@item.Id" asp-route-view="@Model.View" class="btn btn-primary btn-sm">Edit</a>
                                }
                                <a asp-page="./DeleteWarehouse" asp-route-itemid="@item.Id" asp-route-view="@Model.View" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div id="email-popup">
    <p id="popup-id"></p>
    <p id="popup-sender"></p>
    <p id="popup-receiver"></p>
    <p id="popup-receiver-department"></p>
    <p id="popup-subject"></p>
    <p id="popup-body"></p>
    <p id="popup-date-sent"></p>
    <button onclick="closePopup()">Close</button>
</div>
<script>
    // ดึงค่า Anti-Forgery Token
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    // แสดงป๊อปอัปพร้อมส่งคำขอไปยังเซิร์ฟเวอร์
    function showEmailDetails(id, sender, receiver, receiverDepartment, subject,body, dateSent) {
        document.getElementById('popup-id').innerText = "ID: " + id;
        document.getElementById('popup-sender').innerText = "Sender: " + sender;
        document.getElementById('popup-receiver').innerText = "Receiver: " + receiver;
        document.getElementById('popup-receiver-department').innerText = "Receiver Department: " + receiverDepartment;
        document.getElementById('popup-subject').innerText = "Subject: " + subject;
        document.getElementById('popup-body').innerText = "Body: " + body;
        document.getElementById('popup-date-sent').innerText = "Date Sent: " + dateSent;
        document.getElementById('email-popup').style.display = 'block';

        // ส่งคำขอเพื่ออัปเดตสถานะ
        fetch(`/Warehouse/IndexWarehouse?handler=MarkAsRead&id=${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAntiForgeryToken()
            }
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // อัปเดตสถานะในตาราง
                    const row = document.querySelector(`tr[data-id='${id}']`);
                    if (row) {
                        const statusBadge = row.querySelector('.badge');
                        if (statusBadge) {
                            statusBadge.classList.remove('bg-danger');
                            statusBadge.classList.add('bg-success');
                            statusBadge.innerText = 'Read';
                        }
                    }
                } else {
                    console.error("Failed to update status. Server response:", data.error);
                }
            })
            .catch(err => console.error("Request failed:", err));
    }

    // ปิดป๊อปอัป
    function closePopup() {
        document.getElementById('email-popup').style.display = 'none';

    }
</script>