@page
@model ProgrammerTuajew.Pages.Warehouse.EditWarehouseModel
@{
    ViewData["Title"] = "Edit Email - Warehouse";
}
<style>
    body {
        background-color: transparent; /* สีพื้นหลังของ box ข้างนอก */
        color: black; /* ตัวอักษรสีขาว */
    }

    .container-box {
        background-color: #4CC9FE; /* สีพื้นหลังของ box ข้างใน */
        border-radius: 15px; /* ทำให้ขอบมน */
        padding: 20px; /* ระยะห่างด้านใน */
        max-width: 1310px; /* กำหนดความกว้างสูงสุด */
        margin: 30px auto; /* จัดให้อยู่ตรงกลางและเพิ่มระยะด้านบน/ล่าง */
        color: black; /* ตัวอักษรในกล่องเป็นสีดำ */
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); /* เพิ่มเงา */
    }

    label {
        font-weight: bold; /* ทำให้ Label ตัวหนา */
    }

    .btn {
        font-size: 1rem; /* ขนาดตัวอักษรในปุ่ม */
    }
    /* ปุ่ม Update */
    .btn-update {
        background-color: #3D3BF3 !important; /* สีน้ำเงิน */
        border-color: #3D3BF3 !important; /* สีขอบ */
        color: white !important; /* สีตัวอักษร */
        font-weight: bold; /* ตัวหนา */
        transition: background-color 0.3s ease; /* การเปลี่ยนสี */
    }

        .btn-update:hover {
            background-color: #006BFF !important; /* สีน้ำเงินเข้มเมื่อ Hover */
            border-color: #006BFF !important;
        }

    /* ปุ่ม Cancel */
    .btn-cancel {
        background-color: #3C3D37 !important; /* สีเหลือง */
        border-color: #3C3D37 !important; /* สีขอบ */
        color: white !important; /* สีตัวอักษรสีดำ */
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

        .btn-cancel:hover {
            background-color: #697565 !important; /* สีเหลืองเข้มเมื่อ Hover */
            border-color: #697565 !important;
        }

</style>

<h2 class="text-center text-black">Edit Email</h2>

@if (Model.ErrorMessage.Length > 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>@Model.ErrorMessage</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-box">
    <form method="post">
        <input type="hidden" name="Id" value="@Model.SaleInfo.Id" />
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Sender</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Sender" value="@Model.SaleInfo.Sender" readonly />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Receiver</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Receiver" value="@Model.SaleInfo.Receiver" readonly />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Receiver Department</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="ReceiverDepartment" value="@Model.SaleInfo.ReceiverDepartment" readonly />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Subject</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Subject" value="@Model.SaleInfo.Subject" />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Body</label>
            <div class="col-sm-6">
                <textarea class="form-control" name="Body">@Model.SaleInfo.Body</textarea>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Date Sent</label>
            <div class="col-sm-6">
                <input type="date" class="form-control" name="DateSent"
                       value="@((Model.SaleInfo.DateSent.HasValue) ? Model.SaleInfo.DateSent.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
        </div>

        @if (Model.SuccessMessage.Length > 0)
        {
            <div class="row mb-3">
                <div class="col-sm-9 offset-sm-3">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>@Model.SuccessMessage</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <div class="row mb-3">
            <div class="offset-sm-3 col-sm-3 d-grid">
                <button type="submit" class="btn btn-update">Update</button> <!-- ใช้คลาส btn-update -->
            </div>
            <div class="col-sm-3 d-grid">
                <a class="btn btn-cancel" href="/Warehouse/IndexWarehouse?view=inbox" role="button">Cancel</a> <!-- ใช้คลาส btn-cancel -->
            </div>
        </div>
    </form>
</div>