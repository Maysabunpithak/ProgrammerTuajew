@page
@model ProgrammerTuajew.Pages.ForgotPassword.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="d-flex justify-content-center align-items-center" style="background-color: #47d0fe; height: 100vh;">
    <div class="card" style="background-color: #03598f; color: white; border-radius: 15px; padding: 20px; max-width: 400px; width: 100%;">
        <div class="card-body">
            <h2 class="text-center">Reset Password</h2>
            <p class="text-center" style="color: #b3e5fc;">Please enter your email address and new password.</p>

            @if (Model.Message != null)
            {
                <div class="alert alert-info text-center" style="background-color: #b3e5fc; color: #03598f; border-radius: 5px;">
                    @Model.Message
                </div>
            }

            <form method="post">
                <div class="form-group">
                    <label for="email" style="color: white;">Email</label>
                    <input type="email" id="email" name="Email" class="form-control" asp-for="Email" required />
                </div>
                <div class="form-group mt-3">
                    <label for="newPassword" style="color: white;">New Password</label>
                    <input type="password" id="newPassword" name="NewPassword" class="form-control" asp-for="NewPassword" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-4">Reset Password</button>
            </form>
        </div>
    </div>
</div>

<script>
    function hideErrorMessage() {
        document.getElementById("error-message").style.display = "none";
    }
</script>
