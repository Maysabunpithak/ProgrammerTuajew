@page
@model ProgrammerTuajew.Pages.SaleD3.CreateSaleD3Model
@{
    ViewData["Title"] = "Add Email - SaleD3";
}
<style>
    body {
        background-color: transparent; /* สีพื้นหลังของกล่องด้านนอก */
        color: white; /* สีตัวอักษร */
    }

    .container-box {
        background-color: #4CC9FE; /* สีพื้นหลังของกล่องด้านใน */
        border-radius: 15px; /* ทำให้ขอบมน */
        padding: 20px; /* ระยะห่างด้านใน */
        max-width: 1300px; /* กำหนดความกว้างสูงสุด */
        margin: 40px auto; /* จัดให้อยู่ตรงกลางและเพิ่มระยะด้านบน/ล่าง */
        color: black; /* สีตัวอักษรในกล่อง */
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); /* เพิ่มเงา */
    }

    label {
        font-weight: bold; /* ทำให้ Label ตัวหนา */
    }

    .btn {
        font-size: 1rem; /* ขนาดตัวอักษรในปุ่ม */
    }

    /* ปุ่ม Submit */
    .btn-submit {
        background-color: #3D3BF3 !important; /* สีปุ่ม */
        border-color: #3D3BF3 !important; /* สีขอบ */
        color: white !important; /* สีตัวอักษร */
        font-weight: bold; /* ตัวอักษรหนา */
        transition: background-color 0.3s ease; /* เพิ่มการเปลี่ยนสีเมื่อ Hover */
    }

        .btn-submit:hover {
            background-color: #006BFF !important; /* สีเมื่อ Hover */
            border-color: #006BFF !important;
        }

    /* ปุ่ม Cancel */
    .btn-cancel {
        background-color: #3C3D37 !important; /* สีปุ่ม */
        border-color: #3C3D37 !important; /* สีขอบ */
        color: white !important; /* สีตัวอักษร */
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

        .btn-cancel:hover {
            background-color: #697565 !important; /* สีเมื่อ Hover */
            border-color: #697565 !important;
        }
</style>

<br />
<h2 class="text-center text-black">Add Email</h2>

@if (Model.ErrorMessage.Length > 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>@Model.ErrorMessage</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
    </div>
}

<div class="container-box">
    <form method="post">
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Sender</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Sender" value="@Model.SaleInfo.Sender" required />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Receiver</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Receiver" value="@Model.SaleInfo.Receiver" required />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Receiver Department</label>
            <div class="col-sm-6">
                <select class="form-control" name="ReceiverDepartment" required>
                    <option value="SaleD1">SaleD1</option>
                    <option value="SaleD2">SaleD2</option>
                    <option value="SaleD3">SaleD3</option>
                    <option value="Warehouse">Warehouse</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Subject</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Subject" value="@Model.SaleInfo.Subject" required />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Body</label>
            <div class="col-sm-6">
                <textarea class="form-control" name="Body" required>@Model.SaleInfo.Body</textarea>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Date Sent</label>
            <div class="col-sm-6">
                <input type="date" class="form-control" name="DateSent"
                       value="@((Model.SaleInfo.DateSent.HasValue) ? Model.SaleInfo.DateSent.Value.ToString("yyyy-MM-dd") : string.Empty)" required />
            </div>
        </div>

        @if (Model.SuccessMessage.Length > 0)
        {
            <div class="row mb-3">
                <div class="col-sm-9 offset-sm-3">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>@Model.SuccessMessage</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                    </div>
                </div>
            </div>
        }

        <div class="row mb-3">
            <div class="offset-sm-3 col-sm-3 d-grid">
                <button type="submit" class="btn btn-submit">Submit</button> <!-- ใช้คลาส btn-submit -->
            </div>
            <div class="col-sm-3 d-grid">
                <a class="btn btn-cancel" href="/SaleD3/IndexSaleD3?view=inbox" role="button">Cancel</a> <!-- ใช้คลาส btn-cancel -->
            </div>
        </div>
    </form>
</div>
